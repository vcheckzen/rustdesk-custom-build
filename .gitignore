# ---- secrets: never commit, never track ----
# The single local secret store. Everything real lives in here; the committed
# template tools/secrets.env.template carries the key names and the comments.
secrets/
*.env.local

# legacy scattered secret files - superseded by secrets/, kept ignored so a
# forgotten copy can never be committed
ght.txt
ARTIFACTS_PASSPHRASE*
*.passphrase
tools/.keystore.env
*.keystore
*.keystore.b64
*.jks
key.properties

# ---- local only ----
# vendored tools (gh, ...) downloaded on demand; never commit binaries
tools/bin/
.workbuddy-ai/
src/
build/
dist/
target/
*.log
__pycache__/
*.pyc
.DS_Store
Thumbs.db
