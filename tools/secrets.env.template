# =============================================================================
#  RustDesk custom build - LOCAL SECRET STORE (template)
# =============================================================================
#
#  This template is committed. It holds every variable the build needs, but
#  never a value. Copy it to the real store and fill that in:
#
#      ./tools/secrets.sh init        # -> secrets/secrets.env   (chmod 600)
#      $EDITOR secrets/secrets.env    # fill in the values
#      ./tools/secrets.sh check       # validate; never prints a value
#
#  secrets/ is gitignored. Nothing else in this repo may hold a secret:
#  tools/ght.sh, tools/askpass.sh and tools/bootstrap.sh all read this file
#  through ./tools/secrets.sh, so a value never reaches argv, a URL, or a log.
#
#  FORMAT
#    * strictly KEY=value, one per line
#    * "#" starts a comment only at the beginning of a line; there are no
#      inline comments, so "#" and "=" are legal inside a value
#    * a value may be wrapped in one pair of matching 'single' or "double"
#      quotes; they are stripped when read
#    * a value must not contain a newline or a tab
#    * an empty value means "not configured" and is skipped by the tooling
#    * this file is parsed as data, never sourced as shell code
#
#  ANNOTATIONS
#    The "# @..." line directly above a key is read by secrets.sh:
#      @required          must be non-empty, or `check` fails
#      @optional          may be empty
#      @required-if KEY   required only when KEY is non-empty
#      @derived           generated by secrets.sh; do not hand-edit
#      @local             stays on this machine; never uploaded to GitHub
#
#  COMMANDS
#    ./tools/secrets.sh init [--force]   create the store from this template
#    ./tools/secrets.sh edit             open it in $EDITOR
#    ./tools/secrets.sh check            validate (exit 1 on any problem)
#    ./tools/secrets.sh status           redacted overview: set/empty + length
#    ./tools/secrets.sh get KEY          print one value (for command substitution)
#    ./tools/secrets.sh has KEY          exit 0 if set and non-empty
#    ./tools/secrets.sh require KEY...   fail unless every key is set
#    ./tools/secrets.sh run -- cmd ...   run cmd with every key exported
#    ./tools/secrets.sh migrate          import the legacy scattered files
#    ./tools/secrets.sh keystore-encode  refresh ANDROID_KEYSTORE_B64 from the .keystore
#    ./tools/secrets.sh push [--repo R]  upload the CI secrets through gh
#
#  Losing this file means losing the Android signing key: an APK signed with a
#  new key cannot upgrade an already installed one. Back it up somewhere safe
#  (password manager / encrypted archive), never into this repo.
# =============================================================================


# -----------------------------------------------------------------------------
#  1. GitHub access
# -----------------------------------------------------------------------------
#  Everything that talks to the API or pushes over HTTPS authenticates with
#  GH_TOKEN. It is handed to git via GIT_ASKPASS and to the API via a 0600
#  temp curl config, so it is never on a command line.
#
#  Fine-grained token (recommended):
#    * this builder repo          -> Contents: Read and write
#    * the artifacts repo         -> Contents: Read and write  (if you use one)
#  Classic token: `repo` scope covers both.
#
# @required
# @local
GH_TOKEN=

# Account that owns the repos. Left empty, bootstrap.sh asks the API for it.
# @optional
# @local
GH_OWNER=

# Name of this builder repo (the one you are reading). Used by bootstrap.sh
# and by `secrets.sh push` as the default --repo.
# @optional
# @local
GH_REPO=rustdesk-custom-build

# public | private. The builder repo must be public: GitHub gives unlimited
# Actions minutes to public repos and 2000/month to private ones, and a full
# Android + Windows run is far more than that.
# @optional
# @local
GH_VISIBILITY=public


# -----------------------------------------------------------------------------
#  2. Where build output goes
# -----------------------------------------------------------------------------
#  Workflow artifacts on a public repo are downloadable by anyone with a
#  GitHub account - there is no per-user permission. Pick one of:
#
#    a) a PRIVATE companion repo  -> ARTIFACTS_REPO + ARTIFACTS_TOKEN
#       (truly access controlled: only you can download)
#    b) an encryption passphrase  -> ARTIFACTS_PASSPHRASE
#       (public blob, useless without the passphrase)
#
#  Set both and (a) wins. Set neither and the build is uploaded in the clear
#  with a one-day retention and a loud warning in the log.
# -----------------------------------------------------------------------------

# owner/name of an EMPTY private repo, e.g. you/rustdesk-artifacts
# @optional
ARTIFACTS_REPO=

# Token used by the runner to publish there. Fine-grained PAT scoped to that
# one repo with Contents: Read and write. Required as soon as ARTIFACTS_REPO
# is set - the workflow fails loudly instead of falling back to a public
# upload.
# @required-if ARTIFACTS_REPO
ARTIFACTS_TOKEN=

# 64+ random characters. The workflow encrypts the artifact with
# AES-256-CBC/PBKDF2 before uploading and keeps it for 3 days. Printable ASCII,
# no spaces, no quotes. Generate one with:
#     openssl rand -base64 48 | tr -dc 'A-Za-z0-9'
# Decrypt a download with:
#     openssl enc -d -aes-256-cbc -pbkdf2 -md sha256 -in x.enc -out x
# @optional
ARTIFACTS_PASSPHRASE=


# -----------------------------------------------------------------------------
#  3. Android signing
# -----------------------------------------------------------------------------
#  Without a release key the APK is debug-signed: it installs, but every future
#  build needs the app uninstalled first. Generate the key once:
#
#      ./tools/bootstrap.sh          (or see README "Android signing")
#
#  and keep secrets/keystore/release.keystore backed up. Never regenerate it
#  for an app that is already installed.
# -----------------------------------------------------------------------------

# Keystore on this machine, read by `secrets.sh keystore-encode`.
# Relative paths are resolved against the repo root.
# @optional
# @local
ANDROID_KEYSTORE_FILE=secrets/keystore/release.keystore

# Base64 of the keystore above; this is what the runner receives. Regenerate
# with `./tools/secrets.sh keystore-encode` after creating or replacing the key.
# @derived
ANDROID_KEYSTORE_B64=

# Store password and key password. They are the same value unless you set them
# differently when generating the key.
# @required-if ANDROID_KEYSTORE_B64
ANDROID_KEYSTORE_PASSWORD=

# @required-if ANDROID_KEYSTORE_B64
ANDROID_KEY_PASSWORD=

# Key alias inside the keystore. bootstrap.sh creates it as `rustdesk`.
# @optional
ANDROID_KEY_ALIAS=rustdesk


# -----------------------------------------------------------------------------
#  4. Server configuration baked into the build
# -----------------------------------------------------------------------------
#  These are spliced into the Rust sources at build time by patches/apply.py.
#  Any key left empty falls back to a placeholder (im.logi.rd / rd.example.com
#  / empty), which produces a build that starts but cannot reach a server.
#
#  Every value is also changeable at runtime in the app:
#  Settings -> ID/Relay Server. A build with a real key baked in still must not
#  be published publicly - it leaks your server address.
#
#  Port note: put hbbs/hbbr on 443 with websocket enabled. The Baidu front
#  proxy very likely only allows :443 targets, so bare 21116/21117 fail.
# -----------------------------------------------------------------------------

# Android applicationId. Must be reverse-DNS with at least one dot, and stable:
# changing it makes the new APK a different app.
# @optional
RD_APP_ID=im.logi.rd

# Launcher label shown on the phone. UTF-8 is fine.
# @optional
RD_APP_NAME=远程协助

# hbbs host or host:port, e.g. rd.example.com
# @optional
RD_ID_SERVER=

# hbbr host or host:port. Empty means "same host as the ID server".
# @optional
RD_RELAY_SERVER=

# API server for the web console, e.g. https://api.example.com
# @optional
RD_API_SERVER=

# hbbs public key, the base64 blob from `hbbs -h` / the `id_ed25519.pub` file.
# @optional
RD_PUB_KEY=

# Domain whose every occurrence of rustdesk.com is rewritten to it in the
# sources and UI strings. Must be a bare domain, no scheme, no path.
# @optional
RD_SITE_DOMAIN=


# -----------------------------------------------------------------------------
#  5. Access control on the built client
# -----------------------------------------------------------------------------
#  These two are compiled into the binary, so treat a built artifact as
#  "contains a credential". Both are optional: leave them empty and the build
#  keeps stock behaviour (one-time password allowed, no 2FA).
#
#  Setting RD_PERMANENT_PASSWORD also flips verification-method to
#  "use-permanent-password" and approve-mode to "password", i.e. only the
#  permanent password is accepted and no click approval is offered.
# -----------------------------------------------------------------------------

# The permanent (fixed) password baked in as a preset. 6-64 characters, no
# quote, backslash, tab or newline. The fork stores presets in HARD_SETTINGS
# and migrates the plaintext form to salted storage on first use.
# Generate one with: openssl rand -base64 24 | tr -dc 'A-Za-z0-9' | head -c 20
# @optional
RD_PERMANENT_PASSWORD=

# TOTP secret for 2FA on incoming connections, RFC 4648 base32 (A-Z, 2-7),
# unpadded. The app cannot precompute the stored form (it is secretbox
# encrypted with each device's uuid), so the raw secret is compiled in and used
# directly; the UI's QR code shows the same secret.
# Generate one with: head -c 20 /dev/urandom | base32 | tr -d '='
# Add it to your authenticator by typing the characters, or print the otpauth
# URL with: ./tools/secrets.sh totp-uri
# @optional
RD_2FA_SECRET=
